{
	"name": "workout-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite",
		"build": "bun --bun vite build",
		"test": "bun --bun vitest",
		"preview": "bun --bun vite preview",
		"prep": "pnpm svelte-kit sync || echo ''",
		"prep:check": "pnpm svelte-check --output human 2>&1 | tail -20",
		"check": "pnpm svelte-kit sync && pnpm svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "pnpm drizzle-kit generate",
		"db:migrate": "pnpm drizzle-kit migrate",
		"db:push": "pnpm drizzle-kit push",
		"db:studio": "pnpm drizzle-kit studio",
		"lint": "pnpm eslint src --max-warnings 0",
		"test:integration": "bun --bun vitest --run --config vitest.integration.config.ts",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,svelte}": "eslint --max-warnings 0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@typescript-eslint/eslint-plugin": "^8.58.2",
		"@typescript-eslint/parser": "^8.58.2",
		"@vitest/browser": "^4.1.4",
		"eslint": "^10.2.1",
		"eslint-plugin-svelte": "^3.17.0",
		"happy-dom": "^20.9.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"lucide-svelte": "^1.0.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-eslint-parser": "^1.6.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vite-plugin-pwa": "^1.2.0",
		"vitest": "^4.1.4"
	},
	"dependencies": {
		"@libsql/client": "^0.17.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"dexie": "^4.4.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"lucia": "^3.2.2"
	}
}
